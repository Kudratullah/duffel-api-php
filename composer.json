{
  "name": "duffel/api",
  "type": "library",
  "description": "Duffel API SDK for PHP (Flights, Stays, Cars, Places & Identity)",
  "keywords": ["duffel", "flights", "flights-api", "stays", "hotels", "cars", "travel", "sdk"],
  "homepage": "https://duffel.com",
  "license": "MIT",
  "authors": [
    {
      "name": "Duffel Technology Limited",
      "email": "help@duffel.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "php-http/client-common": "^2.7",
    "php-http/discovery": "^1.19",
    "php-http/httplug": "^2.4",
    "php-http/multipart-stream-builder": "^1.3",
    "psr/cache": "^2.0 || ^3.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0 || ^1.1",
    "psr/http-message": "^1.1 || ^2.0",
    "symfony/options-resolver": "^6.4 || ^7.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.9",
    "guzzlehttp/psr7": "^2.7",
    "php-http/mock-client": "^1.6",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Duffel\\": "src/Duffel/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Duffel\\Tests\\": "tests/Duffel/Tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
